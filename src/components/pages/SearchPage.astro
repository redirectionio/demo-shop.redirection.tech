---
import Layout from '../../layouts/Layout.astro';
import { translate } from '../../lib/i18n';
import { type RouteOf } from '../../lib/routing';

type Props = { route: RouteOf<'system-page'> };

const { route } = Astro.props;
const { locale } = route;
const t = translate(locale);
---

<Layout locale={locale} title={t.search.title} description={t.search.title} alternateUrls={route.alternateUrls} indexable={route.indexable}>
    <div class="container-page pt-12">
        <h1 data-search-title class="text-4xl">{t.search.prompt}</h1>
        <form method="get" role="search" class="mt-6 flex max-w-xl gap-3">
            <input type="search" name="q" required aria-label={t.header.search} placeholder={t.header.searchPlaceholder} class="input-field rounded-full" />
            <button class="button-primary">{t.header.search}</button>
        </form>
        <p data-search-no-result hidden class="mt-12 text-muted">{t.search.noResult}</p>
        <ul data-search-results class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6"></ul>
        <template data-search-result>
            <li class="group relative">
                <div class="aspect-4/5 overflow-hidden rounded-lg bg-sand">
                    <img data-result-photo alt="" class="size-full object-cover transition duration-500 group-hover:scale-105" />
                </div>
                <h2 class="mt-3 font-sans text-sm"><a data-result-name class="after:absolute after:inset-0"></a></h2>
                <p data-result-price class="mt-1 text-sm font-medium"></p>
            </li>
        </template>
    </div>
</Layout>

<script>
    import { type Locale, formatPrice, translate } from '../../lib/i18n';

    // Only product pages are indexed (see "data-pagefind-body"), and they all define these metadata.
    type PagefindResult = { url: string; meta: { title: string; image: string; image_alt: string; price: string } };
    type Pagefind = { search: (query: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }> };

    const locale = document.documentElement.lang as Locale;
    const t = translate(locale);
    const query = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';

    for (const input of document.querySelectorAll<HTMLInputElement>('input[name="q"]')) {
        input.value = query;
    }

    if (query !== '') {
        document.querySelector('[data-search-title]')!.textContent = t.search.resultsFor(query);
        // The index is generated by Pagefind after the build: it doesn't exist with "astro dev".
        const pagefindUrl = '/pagefind/pagefind.js';
        const pagefind: Pagefind = await import(/* @vite-ignore */ pagefindUrl);
        const { results } = await pagefind.search(query);
        const products = await Promise.all(results.map((result) => result.data()));

        const template = document.querySelector<HTMLTemplateElement>('[data-search-result]')!;
        document.querySelector('[data-search-results]')!.replaceChildren(
            ...products.map((product) => {
                const item = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
                const photo = item.querySelector<HTMLImageElement>('[data-result-photo]')!;
                photo.src = product.meta.image;
                photo.alt = product.meta.image_alt;
                const name = item.querySelector<HTMLAnchorElement>('[data-result-name]')!;
                name.href = product.url;
                name.textContent = product.meta.title;
                item.querySelector('[data-result-price]')!.textContent = formatPrice(Number(product.meta.price), locale);

                return item;
            }),
        );
        document.querySelector<HTMLElement>('[data-search-no-result]')!.hidden = products.length > 0;
    }
</script>
