---
import type { HTMLAttributes } from 'astro/types';
import type { Product } from '../lib/catalog';
import type { Locale } from '../lib/i18n';
import ProductCard from './ProductCard.astro';

type Props = HTMLAttributes<'div'> & {
    products: Product[];
    locale: Locale;
};

const { products, locale, class: className, ...attributes } = Astro.props;
---

<div {...attributes} class:list={['grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6', className]}>
    {products.map((product) => <ProductCard product={product} locale={locale} />)}
</div>
